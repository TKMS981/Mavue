<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Company>Mavue</Company>
    <Product>Mavue</Product>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en-US;ja-JP</SatelliteResourceLanguages>
    <!-- Windows-specific modules target this TFM; pure-logic modules use net10.0. -->
    <MavueWindowsTfm>net10.0-windows10.0.26100.0</MavueWindowsTfm>
    <MavueMinWindows>10.0.19041.0</MavueMinWindows>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName.EndsWith(`.Tests`))' != 'true'">
    <!-- Keep libraries trimming/NativeAOT-friendly (Quick View host is a NativeAOT candidate). -->
    <IsAotCompatible Condition="'$(OutputType)' != 'WinExe'">true</IsAotCompatible>
  </PropertyGroup>
</Project>
