<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(MavueWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(MavueMinWindows)</TargetPlatformMinVersion>
    <!-- NativeCommandTests call the native command DLL through COM vtables. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Mavue.Shell\Mavue.Shell.csproj" />
    <!-- PreviewNativeTests: pdfium.dll (runtimes/<rid>/native) goes next to the preview DLL under test. -->
    <PackageReference Include="bblanchon.PDFium.Win32" />
    <Compile Include="..\Mavue.Pdf.Tests\TestPdf.cs" Link="TestPdf.cs" />
  </ItemGroup>
</Project>
