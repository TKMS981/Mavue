<Project Sdk="Microsoft.NET.Sdk">
  <!-- Main editor application (WinUI 3 / Windows App SDK). Runs unpackaged for development;
       MSIX packaging is added with Explorer integration (docs/WINDOWS-INTEGRATION.md §0). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(MavueWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(MavueMinWindows)</TargetPlatformMinVersion>
    <RootNamespace>Mavue.App</RootNamespace>
    <AssemblyName>Mavue</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Output is already separated by RID (win-x64 / win-arm64); keep one path regardless of how the build is invoked. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- Bundle the Windows App SDK runtime so the app does not depend on a machine-wide framework package. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- LibraryImport (console attach for the registration switches). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- File Explorer preview handler / thumbnail provider built by tools/build-native.ps1 (artifacts is git-ignored). -->
    <MavueNativePreviewDll>$(MSBuildThisFileDirectory)..\..\artifacts\native\$(RuntimeIdentifier)\Mavue.Shell.Preview.dll</MavueNativePreviewDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Windows App SDK components the viewer uses (WinUI; Foundation for MRT Core resources and the runtime;
         InteractiveExperiences for windowing), as in the Quick View host (docs/DEPENDENCIES.md §0.1). The
         Microsoft.WindowsAppSDK metapackage also brought Windows ML (ONNX Runtime, DirectML), Windows AI, Search and
         Widgets, which nothing uses yet; add components back when a feature (e.g. OCR) needs them. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <!-- Preview pane and thumbnails (docs/WINDOWS-INTEGRATION.md §4–5): registered from this folder by Mavue.exe with
       its register switch, next to the pdfium.dll it uses. Without the DLL the app builds and works as before. While Explorer
       has it loaded (prevhost.exe / the thumbnail process) a changed DLL cannot be copied: unregister or end those first. -->
  <ItemGroup>
    <None Include="$(MavueNativePreviewDll)" Condition="Exists('$(MavueNativePreviewDll)')"
          Link="Mavue.Shell.Preview.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- 32-bit applications (their file dialogs) use the x86 build with the x86 pdfium.dll, registered in the 32-bit view. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\native\win-x86\Mavue.Shell.Preview.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\native\win-x86\Mavue.Shell.Preview.dll')"
          Link="x86\Mavue.Shell.Preview.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\native\win-x86\pdfium.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\native\win-x86\pdfium.dll')"
          Link="x86\pdfium.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mavue.Core\Mavue.Core.csproj" />
    <ProjectReference Include="..\Mavue.Viewer\Mavue.Viewer.csproj" />
    <ProjectReference Include="..\Mavue.Shell\Mavue.Shell.csproj" />
  </ItemGroup>
</Project>
