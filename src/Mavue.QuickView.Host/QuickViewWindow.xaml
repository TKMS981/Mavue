<Window
    x:Class="Mavue.QuickView.Host.QuickViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Solid background (no Mica) keeps the first frame cheap; the harness also uses it as the
       reference color when checking that image pixels are actually on screen. -->
  <Grid x:Name="Root" Background="#FF1E1E1E" IsTabStop="True" KeyDown="OnRootKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Image x:Name="ThumbnailImage" Stretch="Uniform" Margin="12" />
    <Image x:Name="FullImage" Stretch="Uniform" Margin="12" />
    <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="#FFE0E0E0" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center" />

    <StackPanel Grid.Row="1" Padding="16,8,16,12" Spacing="2" Background="#FF181818">
      <TextBlock x:Name="NameText" Foreground="#FFF2F2F2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="InfoText" Foreground="#FFB0B0B0" FontSize="12" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Grid>
</Window>
