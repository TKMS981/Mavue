<Window
    x:Class="Mavue.QuickView.Host.QuickViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Quick Preview window design (docs/ARCHITECTURE.md §4.7.9, Phase 2): one top bar holds the title and the tools
       (content extends into the title bar; Windows draws the caption buttons over its right end). Mica shows only
       through the "chrome" (top bar, filmstrip); the "stage" behind the image is an opaque neutral color, so the
       wallpaper never tints what is around the image. The stage color is also the harness's reference color for
       "image pixels are on screen" (#1E1E1E in the dark theme). Colors come from the theme dictionaries below. -->
  <Grid x:Name="Root" Background="Transparent" IsTabStop="True" KeyDown="OnRootKeyDown" RequestedTheme="Dark">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="QvStageBrush" Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="QvChromeSolidBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="QvSidebarBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="QvPrimaryTextBrush" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="QvSecondaryTextBrush" Color="#FFB0B0B0" />
            <SolidColorBrush x:Key="QvDividerBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="QvOverlayBrush" Color="#E6202020" />
            <SolidColorBrush x:Key="QvOverlayBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="QvOverlayTextBrush" Color="#FFF2F2F2" />
            <Color x:Key="QvCheckerColor1">#FF2C2C2C</Color>
            <Color x:Key="QvCheckerColor2">#FF3A3A3A</Color>
            <!-- Text, code and Markdown preview (Content/Text): token colors after VS Code Dark+ / Light+. -->
            <SolidColorBrush x:Key="QvTextBrush" Color="#FFD4D4D4" />
            <SolidColorBrush x:Key="QvLineNumberBrush" Color="#FF858585" />
            <SolidColorBrush x:Key="QvSyntaxKeywordBrush" Color="#FF569CD6" />
            <SolidColorBrush x:Key="QvSyntaxTypeBrush" Color="#FF4EC9B0" />
            <SolidColorBrush x:Key="QvSyntaxLiteralBrush" Color="#FF569CD6" />
            <SolidColorBrush x:Key="QvSyntaxStringBrush" Color="#FFCE9178" />
            <SolidColorBrush x:Key="QvSyntaxNumberBrush" Color="#FFB5CEA8" />
            <SolidColorBrush x:Key="QvSyntaxCommentBrush" Color="#FF6A9955" />
            <SolidColorBrush x:Key="QvSyntaxPreprocessorBrush" Color="#FFC586C0" />
            <SolidColorBrush x:Key="QvSyntaxTagBrush" Color="#FF569CD6" />
            <SolidColorBrush x:Key="QvSyntaxAttributeBrush" Color="#FF9CDCFE" />
            <SolidColorBrush x:Key="QvSyntaxPropertyBrush" Color="#FF9CDCFE" />
            <SolidColorBrush x:Key="QvSyntaxHeadingBrush" Color="#FF569CD6" />
            <SolidColorBrush x:Key="QvSyntaxInsertedBrush" Color="#FF89D185" />
            <SolidColorBrush x:Key="QvSyntaxDeletedBrush" Color="#FFF48771" />
            <SolidColorBrush x:Key="QvSyntaxVariableBrush" Color="#FF9CDCFE" />
            <SolidColorBrush x:Key="QvSyntaxErrorBrush" Color="#FFF48771" />
            <SolidColorBrush x:Key="QvSyntaxWarningBrush" Color="#FFCCA700" />
            <SolidColorBrush x:Key="QvCodeBlockBrush" Color="#FF262626" />
            <SolidColorBrush x:Key="QvLinkBrush" Color="#FF4CC2FF" />
            <SolidColorBrush x:Key="QvNoticeBrush" Color="#FF2B2B2B" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="QvStageBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="QvChromeSolidBrush" Color="#FFF9F9F9" />
            <SolidColorBrush x:Key="QvSidebarBrush" Color="#FFEBEBEB" />
            <SolidColorBrush x:Key="QvPrimaryTextBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="QvSecondaryTextBrush" Color="#FF5C5C5C" />
            <SolidColorBrush x:Key="QvDividerBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="QvOverlayBrush" Color="#EBFFFFFF" />
            <SolidColorBrush x:Key="QvOverlayBorderBrush" Color="#26000000" />
            <SolidColorBrush x:Key="QvOverlayTextBrush" Color="#FF1A1A1A" />
            <Color x:Key="QvCheckerColor1">#FFFFFFFF</Color>
            <Color x:Key="QvCheckerColor2">#FFE3E3E3</Color>
            <SolidColorBrush x:Key="QvTextBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="QvLineNumberBrush" Color="#FF6E7681" />
            <SolidColorBrush x:Key="QvSyntaxKeywordBrush" Color="#FF0000FF" />
            <SolidColorBrush x:Key="QvSyntaxTypeBrush" Color="#FF267F99" />
            <SolidColorBrush x:Key="QvSyntaxLiteralBrush" Color="#FF0000FF" />
            <SolidColorBrush x:Key="QvSyntaxStringBrush" Color="#FFA31515" />
            <SolidColorBrush x:Key="QvSyntaxNumberBrush" Color="#FF098658" />
            <SolidColorBrush x:Key="QvSyntaxCommentBrush" Color="#FF008000" />
            <SolidColorBrush x:Key="QvSyntaxPreprocessorBrush" Color="#FFAF00DB" />
            <SolidColorBrush x:Key="QvSyntaxTagBrush" Color="#FF800000" />
            <SolidColorBrush x:Key="QvSyntaxAttributeBrush" Color="#FFE50000" />
            <SolidColorBrush x:Key="QvSyntaxPropertyBrush" Color="#FF0451A5" />
            <SolidColorBrush x:Key="QvSyntaxHeadingBrush" Color="#FF800000" />
            <SolidColorBrush x:Key="QvSyntaxInsertedBrush" Color="#FF098658" />
            <SolidColorBrush x:Key="QvSyntaxDeletedBrush" Color="#FFA31515" />
            <SolidColorBrush x:Key="QvSyntaxVariableBrush" Color="#FF001080" />
            <SolidColorBrush x:Key="QvSyntaxErrorBrush" Color="#FFCD3131" />
            <SolidColorBrush x:Key="QvSyntaxWarningBrush" Color="#FF946300" />
            <SolidColorBrush x:Key="QvCodeBlockBrush" Color="#FFEAEAEA" />
            <SolidColorBrush x:Key="QvLinkBrush" Color="#FF005FB8" />
            <SolidColorBrush x:Key="QvNoticeBrush" Color="#FFE6E6E6" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="QvStageBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QvChromeSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QvSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QvPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QvOverlayBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvOverlayTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <Color x:Key="QvCheckerColor1">#FFFFFFFF</Color>
            <Color x:Key="QvCheckerColor2">#FFC0C0C0</Color>
            <!-- High contrast: system text color only (no syntax colors). -->
            <SolidColorBrush x:Key="QvTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvLineNumberBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxKeywordBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxTypeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxLiteralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxStringBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxNumberBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxCommentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxPreprocessorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxTagBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxAttributeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxPropertyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxHeadingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxInsertedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxDeletedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxVariableBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvSyntaxWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QvCodeBlockBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QvLinkBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="QvNoticeBrush" Color="{ThemeResource SystemColorWindowColor}" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <!-- Flat icon buttons of the top bar: 36 × 32, 16 px glyphs, no fill until hovered. Not tab stops (Space and
             Esc stay with the window); F6 moves the keyboard into the bar. -->
        <Style x:Key="QvToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
          <Setter Property="Width" Value="36" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="IsTabStop" Value="False" />
          <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
          <Setter Property="FontSize" Value="16" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="QvToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
          <Setter Property="Width" Value="36" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="IsTabStop" Value="False" />
          <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
          <Setter Property="FontSize" Value="16" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </ResourceDictionary>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Tool bar under Windows' own title bar (which shows the file's name). Over Mica the title bar and this bar read
         as one band. The title bar is not customized: extending content into it or recoloring its buttons made every
         show of the window ~10 ms slower (measured 2026-10-30, docs/ARCHITECTURE.md §4.7.9).
         Left: the file's facts with a file icon — drag it out to copy the file. Transparent over Mica; solid without. -->
    <Grid x:Name="TopBar" Height="44" Padding="12,0,8,0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MaxWidth="560" />
        <ColumnDefinition Width="*" MinWidth="24" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="FileChip" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Background="Transparent"
                  Padding="4,6" CornerRadius="4" AutomationProperties.AutomationId="QuickViewFileChip">
        <FontIcon Glyph="&#xE7C3;" FontSize="16" Foreground="{ThemeResource QvSecondaryTextBrush}" />
        <TextBlock x:Name="NameText" Visibility="Collapsed" />
        <TextBlock x:Name="InfoText" Foreground="{ThemeResource QvSecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <StackPanel x:Name="ToolBar" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <!-- PDF with PDFium: sidebar, find, layout, presentation. -->
        <StackPanel x:Name="PdfTools" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
          <ToggleButton x:Name="SidebarButton" Style="{StaticResource QvToolToggle}" Click="OnSidebarClick" Content="&#xE8A9;" />
          <Button x:Name="SearchButton" Style="{StaticResource QvToolButton}" Click="OnSearchClick" Content="&#xE721;" />
          <DropDownButton x:Name="LayoutButton" IsTabStop="False" Height="32" Padding="8,0" VerticalAlignment="Center" BorderThickness="0"
                          Background="{ThemeResource SubtleFillColorTransparentBrush}" AutomationProperties.AutomationId="QuickViewLayoutButton">
            <DropDownButton.Content>
              <FontIcon Glyph="&#xE8A1;" FontSize="16" />
            </DropDownButton.Content>
            <DropDownButton.Flyout>
              <MenuFlyout Placement="Bottom">
                <RadioMenuFlyoutItem x:Name="LayoutSingleItem" GroupName="QvPdfLayout" Tag="SinglePage" Click="OnLayoutClick" />
                <RadioMenuFlyoutItem x:Name="LayoutContinuousItem" GroupName="QvPdfLayout" Tag="Continuous" Click="OnLayoutClick" />
                <RadioMenuFlyoutItem x:Name="LayoutTwoPagesItem" GroupName="QvPdfLayout" Tag="TwoPages" Click="OnLayoutClick" />
                <RadioMenuFlyoutItem x:Name="LayoutTwoPagesCoverItem" GroupName="QvPdfLayout" Tag="TwoPagesCover" Click="OnLayoutClick" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button x:Name="PresentationButton" Style="{StaticResource QvToolButton}" Click="OnPresentationClick" Content="&#xE7F4;" />
          <Border Width="1" Height="20" Margin="6,0" Background="{ThemeResource QvDividerBrush}" />
        </StackPanel>
        <!-- Pages of a multi-page PDF (also PageUp/PageDown and the mouse wheel). -->
        <StackPanel x:Name="PageButtons" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
          <Button x:Name="PreviousPageButton" Style="{StaticResource QvToolButton}" Click="OnPreviousPageClick" Content="&#xE76B;" />
          <TextBox x:Name="PageBox" Width="52" MinWidth="0" Height="30" MinHeight="0" Padding="4,4,4,0" TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" KeyDown="OnPageBoxKeyDown" AutomationProperties.AutomationId="QuickViewPageBox" />
          <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Foreground="{ThemeResource QvSecondaryTextBrush}" Margin="2,0,2,0" Visibility="Collapsed" />
          <Button x:Name="NextPageButton" Style="{StaticResource QvToolButton}" Click="OnNextPageClick" Content="&#xE76C;" />
          <Border Width="1" Height="20" Margin="6,0" Background="{ThemeResource QvDividerBrush}" />
        </StackPanel>
        <!-- Text, code, Markdown and HTML: rendered view or source (Ctrl+U), line wrapping (W). -->
        <StackPanel x:Name="TextTools" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
          <ToggleButton x:Name="SourceButton" Style="{StaticResource QvToolToggle}" Click="OnSourceClick" Content="&#xE943;" AutomationProperties.AutomationId="QuickViewSourceButton" />
          <ToggleButton x:Name="WrapButton" Style="{StaticResource QvToolToggle}" Click="OnWrapClick" Content="&#xE751;" AutomationProperties.AutomationId="QuickViewWrapButton" />
          <Border Width="1" Height="20" Margin="6,0" Background="{ThemeResource QvDividerBrush}" />
        </StackPanel>
        <!-- Zoom and rotation (images, GIFs, PDF pages, SVG, PDF documents; the text size of text). -->
        <StackPanel x:Name="ViewButtons" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
          <Button x:Name="ZoomOutButton" Style="{StaticResource QvToolButton}" Click="OnZoomOutClick" Content="&#xE71F;" />
          <Button x:Name="ZoomFitButton" Style="{StaticResource QvToolButton}" Click="OnZoomFitClick" Width="Auto" MinWidth="52" Padding="6,0" FontFamily="Segoe UI Variable Text,Segoe UI" FontSize="12" Foreground="{ThemeResource QvPrimaryTextBrush}" />
          <Button x:Name="ZoomInButton" Style="{StaticResource QvToolButton}" Click="OnZoomInClick" Content="&#xE710;" />
          <Button x:Name="RotateButton" Style="{StaticResource QvToolButton}" Click="OnRotateClick" Content="&#xE7AD;" />
          <Border Width="1" Height="20" Margin="6,0" Background="{ThemeResource QvDividerBrush}" />
        </StackPanel>
        <!-- Filmstrip, pixel inspector (images) and pin. -->
        <ToggleButton x:Name="FilmstripButton" Style="{StaticResource QvToolToggle}" Click="OnFilmstripClick" Content="&#xE7AA;" AutomationProperties.AutomationId="QuickViewFilmstripButton" />
        <ToggleButton x:Name="InspectorButton" Style="{StaticResource QvToolToggle}" Click="OnInspectorClick" Content="&#xEF3C;" Visibility="Collapsed" AutomationProperties.AutomationId="QuickViewInspectorButton" />
        <!-- Images: EXIF card (E), check before sharing, similar images in the folder (Phase 5, ARCHITECTURE §4.7.13–14). -->
        <ToggleButton x:Name="ExifButton" Style="{StaticResource QvToolToggle}" Click="OnExifClick" Content="&#xE946;" Visibility="Collapsed" AutomationProperties.AutomationId="QuickViewExifButton" />
        <Button x:Name="ShareCheckButton" Style="{StaticResource QvToolButton}" Click="OnShareCheckClick" Content="&#xEA18;" Visibility="Collapsed" AutomationProperties.AutomationId="QuickViewShareCheckButton" />
        <Button x:Name="SimilarButton" Style="{StaticResource QvToolButton}" Click="OnSimilarClick" Content="&#xE8B9;" Visibility="Collapsed" AutomationProperties.AutomationId="QuickViewSimilarButton" />
        <ToggleButton x:Name="PinButton" Style="{StaticResource QvToolToggle}" Click="OnPinClick" Content="&#xE718;" AutomationProperties.AutomationId="QuickViewPinButton" />
        <Border Width="1" Height="20" Margin="6,0" Background="{ThemeResource QvDividerBrush}" />
        <Button x:Name="OpenInMavueButton" Style="{StaticResource QvToolButton}" Click="OnOpenInMavueClick" Content="&#xE8A7;" Visibility="Collapsed" />
        <Button x:Name="MoreButton" Style="{StaticResource QvToolButton}" Content="&#xE712;" AutomationProperties.AutomationId="QuickViewMoreButton">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuFlyoutItem x:Name="OpenWithItem" Click="OnOpenWithClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE7AC;" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator />
              <ToggleMenuFlyoutItem x:Name="TransparencyGridItem" Click="OnTransparencyGridClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <!-- PDF: find (shared PdfSearchBar) under the top bar, and the sidebar (shared PdfSidebar) on the left, added in code. -->
    <Grid x:Name="SearchHost" Grid.Row="1" Padding="0,4,0,4" Visibility="Collapsed" Background="{ThemeResource QvStageBrush}" />

    <!-- The stage: image, video/audio, documents and messages on the viewer surface shared with Mavue.App
         (Mavue.Viewer.Controls.ViewerSurface), added in code. Opaque, so backdrops never show around the image. -->
    <Grid x:Name="Stage" Grid.Row="2" Background="{ThemeResource QvStageBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="SidebarHost" Width="232" Visibility="Collapsed" Background="{ThemeResource QvSidebarBrush}" />
      <Grid x:Name="SurfaceHost" Grid.Column="1" />
      <!-- HTML preview: the WebView2 lives here (created for the first HTML file, released when Quick View closes). -->
      <Grid x:Name="WebHost" Grid.Column="1" Visibility="Collapsed" />
      <!-- Universal Preview: the information card for files no other content shows (added in code). -->
      <Grid x:Name="CardHost" Grid.Column="1" Visibility="Collapsed" />
      <!-- Pixel inspector: a small card over a corner of the image (no blur, so the image's colors stay as they are); it never takes the pointer. -->
      <Border x:Name="InspectorPanel" Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Padding="10,8" CornerRadius="8"
              Background="{ThemeResource QvOverlayBrush}" BorderBrush="{ThemeResource QvOverlayBorderBrush}" BorderThickness="1"
              AutomationProperties.AutomationId="QuickViewPixelInspector">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border x:Name="InspectorSwatch" Width="36" Height="36" CornerRadius="4" BorderBrush="{ThemeResource QvOverlayBorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
          <StackPanel Spacing="1">
            <TextBlock x:Name="InspectorPosition" FontFamily="Cascadia Mono,Consolas" FontSize="12" Foreground="{ThemeResource QvOverlayTextBrush}" />
            <TextBlock x:Name="InspectorRgb" FontFamily="Cascadia Mono,Consolas" FontSize="12" Foreground="{ThemeResource QvOverlayTextBrush}" />
            <TextBlock x:Name="InspectorHex" FontFamily="Cascadia Mono,Consolas" FontSize="12" Foreground="{ThemeResource QvOverlayTextBrush}" />
            <TextBlock x:Name="InspectorAlpha" FontFamily="Cascadia Mono,Consolas" FontSize="12" Foreground="{ThemeResource QvOverlayTextBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- EXIF card: the shot at a glance over the image's top-right corner (filled in code; never covers the inspector). -->
      <Grid x:Name="ExifHost" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Visibility="Collapsed" />
    </Grid>

    <!-- Filmstrip: neighbors in Explorer's order (or the selection), added in code. Off by default; part of the chrome. -->
    <Grid x:Name="FilmstripHost" Grid.Row="3" Height="88" Visibility="Collapsed" Background="Transparent" />

    <!-- Similar images: results of an explicit search (filled in code; part of the chrome, closed with its button). -->
    <Grid x:Name="SimilarHost" Grid.Row="4" Height="140" Visibility="Collapsed" Background="Transparent" />
  </Grid>
</Window>
