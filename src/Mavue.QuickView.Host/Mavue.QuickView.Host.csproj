<Project Sdk="Microsoft.NET.Sdk">
  <!-- Resident Quick View process (docs/ARCHITECTURE.md §4.5): keyboard hook, Explorer selection,
       pre-created preview window, progressive image/PDF preview. Runs unpackaged for development. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(MavueWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(MavueMinWindows)</TargetPlatformMinVersion>
    <RootNamespace>Mavue.QuickView.Host</RootNamespace>
    <AssemblyName>Mavue.QuickView.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Output is already separated by RID (win-x64 / win-arm64); keep one path regardless of how the build is invoked. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mavue.Core\Mavue.Core.csproj" />
    <ProjectReference Include="..\Mavue.QuickView\Mavue.QuickView.csproj" />
    <ProjectReference Include="..\Mavue.Image\Mavue.Image.csproj" />
  </ItemGroup>
</Project>
