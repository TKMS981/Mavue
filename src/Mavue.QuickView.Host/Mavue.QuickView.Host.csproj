<Project Sdk="Microsoft.NET.Sdk">
  <!-- Resident Quick View process (docs/ARCHITECTURE.md §4.5): keyboard hook, Explorer selection,
       pre-created preview window, progressive image/PDF preview. Runs unpackaged for development. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(MavueWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(MavueMinWindows)</TargetPlatformMinVersion>
    <RootNamespace>Mavue.QuickView.Host</RootNamespace>
    <AssemblyName>Mavue.QuickView.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Output is already separated by RID (win-x64 / win-arm64); keep one path regardless of how the build is invoked. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs handles quickview forwarding and registration before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Windows App SDK components the host uses (WinUI; Foundation for MRT Core resources and the
         runtime; InteractiveExperiences for windowing/composition; Base comes with them). The Microsoft.WindowsAppSDK metapackage also
         pulled in Windows ML (ONNX Runtime, DirectML), Windows AI, Search and Widgets: about 56 MB of the output,
         never loaded (measured, docs/DEPENDENCIES.md §0.1). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <!-- Pinned to the metapackage's version: WinUI 2.3.9 asks for >= 2.1.8, which is not published (NU1603). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mavue.Core\Mavue.Core.csproj" />
    <ProjectReference Include="..\Mavue.QuickView\Mavue.QuickView.csproj" />
    <ProjectReference Include="..\Mavue.Image\Mavue.Image.csproj" />
    <ProjectReference Include="..\Mavue.Shell\Mavue.Shell.csproj" />
  </ItemGroup>
</Project>
